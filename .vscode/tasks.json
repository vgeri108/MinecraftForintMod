{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build NeoForge mod",
      "type": "process",
      "command": "gradlew.bat",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Minecraft client",
      "type": "process",
      "command": "gradlew.bat",
      "args": ["runClient"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Minecraft server",
      "type": "process",
      "command": "gradlew.bat",
      "args": ["runServer"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
